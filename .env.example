# =============================================================================
# Tydigo Environment Variables
# =============================================================================
# Copy this file to .env (Vite) or .env.local (Next.js) and fill in values.
# NEVER commit .env, .env.local, or any file containing real secrets.
#
# FRAMEWORK NOTE: This project currently uses Vite.
#   - Public (browser-exposed) variables MUST use VITE_ prefix.
#   - Server-side secrets (no VITE_ prefix) are NEVER exposed to the browser.
#   - For future Next.js migration: VITE_ → NEXT_PUBLIC_ for public vars.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Tydigo
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:8080
VITE_DEFAULT_COUNTRY_CODE=+234
VITE_DEFAULT_CITY=Abuja
VITE_TIMEZONE=Africa/Lagos
VITE_CURRENCY=NGN

# ── API ──────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Maps & Location ──────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAP_PROVIDER=placeholder

# ── Paystack ─────────────────────────────────────────────────────────────────
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=

# ── PWA Features ─────────────────────────────────────────────────────────────
VITE_ENABLE_PWA=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_MOCK_AUTH=true
VITE_ENABLE_MOCK_PAYMENTS=true
VITE_ENABLE_MOCK_MAPS=true

# ── Push Notifications (Web Push / VAPID) ────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@tydigo.com

# ── SMS / OTP Provider (Termii or Twilio) ────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Tydigo
TERMII_CHANNEL=generic
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_INVITE_CODE=

# =============================================================================
# SECURITY RULES
# =============================================================================
# ✅ PUBLIC — safe for browser (VITE_ prefix):
#    VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_PAYSTACK_PUBLIC_KEY,
#    VITE_VAPID_PUBLIC_KEY, VITE_GOOGLE_MAPS_API_KEY
#
# ❌ SERVER-ONLY — NEVER put in VITE_ variables or frontend code:
#    SUPABASE_SERVICE_ROLE_KEY, PAYSTACK_SECRET_KEY, VAPID_PRIVATE_KEY,
#    PAYSTACK_WEBHOOK_SECRET, TERMII_API_KEY, TWILIO_AUTH_TOKEN,
#    ADMIN_INVITE_CODE
#
# Secret variables belong in:
#   - Vercel Environment Variables (production)
#   - Supabase Edge Functions / secrets
#   - Server-side worker environment
# =============================================================================
